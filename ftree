#!/usr/bin/env -S uv run --quiet --script
# /// script
# dependencies = ["rich"]
# ///

import argparse
from datetime import datetime
import grp
import io
import os
import pwd
import shutil
import stat
import subprocess
import sys
from os import readlink
from pathlib import Path

from rich.console import Console
from rich.filesize import decimal as human_size
from rich.text import Text
from rich.tree import Tree


HIDE_PATTERNS = [
    ".DS_Store",
    "__pycache__",
    "*.egg-info",
    "*.pyc",
    "*.pyo",
    ".*_cache",
    ".cache",
    ".*_checkpoints",
    "*~",
    ".tmp*",
]
STUB_NAMES = [".claude", ".local", ".venv", "trash", ".trash", "_to_delete"]
STUB_PATTERNS = ["*.git", "*tmp"]


def main():
    parser = argparse.ArgumentParser(
        prog="ftree",
        description="Display directory tree with permissions and sizes.",
        epilog="When path is omitted and stdin is a pipe, reads paths from stdin (one per line) and renders them as a tree.",
        add_help=False,
    )
    parser.add_argument("path", nargs="?", default=None, help="Root path (default: .)")
    parser.add_argument(
        "-I",
        "--ignore",
        action="append",
        default=[],
        metavar="GLOB",
        help="Additional glob to hide entirely (repeatable)",
    )
    parser.add_argument(
        "-u", "--user-group", action="store_true", help="Show user and group columns"
    )
    parser.add_argument(
        "-d",
        "--date",
        action="store_true",
        help="Show ISO date and time before object name",
    )
    parser.add_argument(
        "-w",
        "--weekday",
        action="store_true",
        help="Show weekday abbreviation (use alone or with -d)",
    )
    parser.add_argument(
        "-n",
        "--no-pager",
        action="store_true",
        help="Disable paging even when output exceeds terminal height",
    )
    parser.add_argument(
        "-h", "--help", action="help", help="Show this help message and exit"
    )
    args = parser.parse_args()

    if args.path is None and not sys.stdin.isatty():
        main_stdin(args)
        return

    root = Path(args.path or ".")
    console = Console()

    try:
        root_st = root.lstat()
    except OSError as e:
        console.print(f"[red]Error:[/red] {e}")
        raise SystemExit(1)

    root_label = format_label(
        root,
        root_st,
        args.user_group,
        args.date,
        args.weekday,
        display_name=str(root) + "/",
    )
    tree = Tree(root_label)
    add_node(tree, root, args.ignore, args.user_group, args.date, args.weekday)
    if sys.stdout.isatty() and not args.no_pager:
        rendered = _render_tree_ansi(console, tree)
        if rendered.count("\n") > console.height:
            pager_cmd, _ = _find_pager()
            if pager_cmd:
                _page_output(rendered, pager_cmd)
            else:
                sys.stdout.write(rendered)
            return
    console.print(tree)


def main_stdin(args):
    raw = sys.stdin.read().splitlines()
    paths = sorted(p.strip() for p in raw if p.strip())
    if not paths:
        return

    trie = {}
    for path_str in paths:
        node = trie
        for part in Path(path_str).parts:
            node = node.setdefault(part, {})

    console = Console()

    if len(trie) == 1:
        root_name = next(iter(trie))
        root_path = Path(root_name)
        root_children = trie[root_name]
        try:
            root_st = root_path.lstat()
            root_label = format_label(
                root_path,
                root_st,
                args.user_group,
                args.date,
                args.weekday,
                display_name=root_name + "/",
            )
        except OSError:
            root_label = Text(root_name + "/")
        tree = Tree(root_label)
        _add_trie_nodes(
            tree, root_children, root_path, args.user_group, args.date, args.weekday
        )
    else:
        tree = Tree(".")
        _add_trie_nodes(tree, trie, Path("."), args.user_group, args.date, args.weekday)

    if sys.stdout.isatty() and not args.no_pager:
        rendered = _render_tree_ansi(console, tree)
        if rendered.count("\n") > console.height:
            pager_cmd, _ = _find_pager()
            if pager_cmd:
                _page_output(rendered, pager_cmd)
            else:
                sys.stdout.write(rendered)
            return
    console.print(tree)


def _find_pager():
    pager_env = os.environ.get("PAGER")
    if pager_env is not None:
        if not pager_env.strip():
            return None, False
        parts = pager_env.split()
        base = shutil.which(parts[0])
        if base and os.path.basename(base) == "less":
            if "-R" not in parts:
                pager_env += " -R"
            return pager_env, True
        return pager_env, False
    if shutil.which("less"):
        return "less -R", True
    if shutil.which("more"):
        return "more", False
    return None, False


def _render_tree_ansi(console, tree):
    buf = io.StringIO()
    buf_console = Console(file=buf, force_terminal=True, width=console.width)
    buf_console.print(tree)
    return buf.getvalue()


def _page_output(content, pager_cmd):
    proc = subprocess.Popen(pager_cmd, shell=True, stdin=subprocess.PIPE)
    try:
        proc.communicate(content.encode())
    except BrokenPipeError:
        pass


def add_node(tree, path, extra_globs, show_ug, show_date=False, show_weekday=False):
    try:
        children = sorted(path.iterdir(), key=lambda p: p.name.lower())
    except PermissionError:
        return

    for child in children:
        if should_hide(child, extra_globs):
            continue
        try:
            child_st = child.lstat()
        except OSError:
            continue
        if child.name.rstrip("\r") == "Icon" and child_st.st_size == 0:
            continue

        stub = is_stub(child)
        label = format_label(
            child, child_st, show_ug, show_date, show_weekday, stub=stub
        )

        if child.is_symlink() or stub:
            tree.add(label)
        elif child.is_dir():
            branch = tree.add(label)
            add_node(branch, child, extra_globs, show_ug, show_date, show_weekday)
        else:
            tree.add(label)


def _add_trie_nodes(
    node, trie, parent_path, show_ug, show_date=False, show_weekday=False
):
    for name in sorted(trie.keys(), key=str.lower):
        child_path = parent_path / name
        children = trie[name]
        try:
            child_st = child_path.lstat()
            stub = is_stub(child_path)
            label = format_label(
                child_path, child_st, show_ug, show_date, show_weekday, stub=stub
            )
        except OSError:
            label = Text(name + ("/" if children else ""))
        if children:
            branch = node.add(label)
            _add_trie_nodes(
                branch, children, child_path, show_ug, show_date, show_weekday
            )
        else:
            node.add(label)


def format_label(
    path, st, show_ug, show_date, show_weekday, display_name=None, stub=False
):
    text = Text()
    text.append(stat.filemode(st.st_mode), style="dim")
    text.append("  ")

    if show_ug:
        try:
            user = pwd.getpwuid(st.st_uid).pw_name
        except KeyError:
            user = str(st.st_uid)
        try:
            group = grp.getgrgid(st.st_gid).gr_name
        except KeyError:
            group = str(st.st_gid)
        text.append(f"{user:<12}", style="green")
        text.append(f"{group:<12}", style="green")

    text.append(size_text(st))
    text.append("  ")

    if show_date or show_weekday:
        mtime = datetime.fromtimestamp(st.st_mtime)
        if show_weekday:
            weekday = mtime.strftime("%a")
            text.append(weekday, style="yellow")
            text.append(" ")
        if show_date:
            text.append(mtime.isoformat(), style="yellow")
        text.append("  ")

    name = display_name or _node_name(path, stub)
    text.append(name, style=_name_style(path, stub))

    if path.is_symlink():
        target = readlink(path)
        text.append(f" -> {target}", style="dim italic")

    return text


def should_hide(path, extra_globs):
    for pattern in HIDE_PATTERNS + extra_globs:
        if path.match(pattern):
            return True
    return False


def is_stub(path):
    if path.is_symlink() or not path.is_dir():
        return False
    if path.name in STUB_NAMES:
        return True
    return any(path.match(pattern) for pattern in STUB_PATTERNS)


def _node_name(path, stub):
    if path.is_symlink():
        return path.name
    if stub or path.is_dir():
        return path.name + "/"
    return path.name


def _name_style(path, stub):
    if path.is_symlink():
        return "italic"
    if stub:
        return "bold blue dim"
    if path.is_dir():
        return "bold blue"
    return ""


def size_text(st):
    if stat.S_ISDIR(st.st_mode):
        return Text("         —", style="cyan")
    return Text(f"{human_size(st.st_size):>10}", style="cyan")


if __name__ == "__main__":
    main()
