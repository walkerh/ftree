#!/usr/bin/env -S uv run --quiet --script
# /// script
# dependencies = ["rich"]
# ///

import argparse
import grp
import pwd
import stat
from os import readlink
from pathlib import Path

from rich.console import Console
from rich.filesize import decimal as human_size
from rich.text import Text
from rich.tree import Tree


HIDE_PATTERNS = [
    ".DS_Store",
    "__pycache__",
    "*.egg-info",
    "*.pyc",
    "*.pyo",
    ".*_cache",
    ".*_checkpoints",
]
STUB_NAMES = [".venv", "trash", ".trash"]
STUB_PATTERNS = ["*.git","*tmp"]


def main():
    parser = argparse.ArgumentParser(
        prog="rtree",
        description="Display directory tree with permissions and sizes.",
        add_help=False,
    )
    parser.add_argument("path", nargs="?", default=".", help="Root path (default: .)")
    parser.add_argument(
        "-I",
        "--ignore",
        action="append",
        default=[],
        metavar="GLOB",
        help="Additional glob to hide entirely (repeatable)",
    )
    parser.add_argument(
        "-u", "--user-group", action="store_true", help="Show user and group columns"
    )
    parser.add_argument(
        "-h", "--help", action="help", help="Show this help message and exit"
    )
    args = parser.parse_args()

    root = Path(args.path)
    console = Console()

    try:
        root_st = root.lstat()
    except OSError as e:
        console.print(f"[red]Error:[/red] {e}")
        raise SystemExit(1)

    root_label = format_label(
        root, root_st, args.user_group, display_name=str(root) + "/"
    )
    tree = Tree(root_label)
    add_node(tree, root, args.ignore, args.user_group)
    console.print(tree)


def add_node(tree, path, extra_globs, show_ug):
    try:
        children = sorted(path.iterdir(), key=lambda p: p.name.lower())
    except PermissionError:
        return

    for child in children:
        if should_hide(child, extra_globs):
            continue
        try:
            child_st = child.lstat()
        except OSError:
            continue

        stub = is_stub(child)
        label = format_label(child, child_st, show_ug, stub=stub)

        if child.is_symlink() or stub:
            tree.add(label)
        elif child.is_dir():
            branch = tree.add(label)
            add_node(branch, child, extra_globs, show_ug)
        else:
            tree.add(label)


def format_label(path, st, show_ug, display_name=None, stub=False):
    text = Text()
    text.append(stat.filemode(st.st_mode), style="dim")
    text.append("  ")

    if show_ug:
        try:
            user = pwd.getpwuid(st.st_uid).pw_name
        except KeyError:
            user = str(st.st_uid)
        try:
            group = grp.getgrgid(st.st_gid).gr_name
        except KeyError:
            group = str(st.st_gid)
        text.append(f"{user:<12}", style="green")
        text.append(f"{group:<12}", style="green")

    text.append(size_text(st))
    text.append("  ")

    name = display_name or _node_name(path, stub)
    text.append(name, style=_name_style(path, stub))

    if path.is_symlink():
        target = readlink(path)
        text.append(f" -> {target}", style="dim italic")

    return text


def should_hide(path, extra_globs):
    for pattern in HIDE_PATTERNS + extra_globs:
        if path.match(pattern):
            return True
    return False


def is_stub(path):
    if path.is_symlink() or not path.is_dir():
        return False
    if path.name in STUB_NAMES:
        return True
    return any(path.match(pattern) for pattern in STUB_PATTERNS)


def _node_name(path, stub):
    if path.is_symlink():
        return path.name
    if stub or path.is_dir():
        return path.name + "/"
    return path.name


def _name_style(path, stub):
    if path.is_symlink():
        return "italic"
    if stub:
        return "bold blue dim"
    if path.is_dir():
        return "bold blue"
    return ""


def size_text(st):
    if stat.S_ISDIR(st.st_mode):
        return Text("         —", style="cyan")
    return Text(f"{human_size(st.st_size):>10}", style="cyan")


if __name__ == "__main__":
    main()
